{
  "name": "jingling-desktop-pet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "tauri:build:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-qa.ps1",
    "tauri:build:release": "tauri build --no-bundle",
    "tauri:promote": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/promote-qa-to-release.ps1",
    "tauri:bundle": "tauri build",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build:apk": "tauri android build --apk",
    "chat:silo": "node scripts/silo-chat.mjs",
    "vision:bridge": "node scripts/moondream-vision-bridge.mjs",
    "start:pet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pet.ps1 -Channel release",
    "start:pet:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pet.ps1 -Channel release",
    "start:pet:qa": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pet.ps1 -Channel qa",
    "start:pet:auto": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pet.ps1 -Channel auto"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-react": "^1.14.0",
    "pixi.js": "^8.18.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "untitled-pixi-live2d-engine": "^1.1.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
